#!/usr/bin/env bash
# Alfie's dev loop. Everything runs in containers or host python3 stdlib, so
# nothing is installed on raccoon. Run ./dev with no arguments for the list.
set -euo pipefail
cd "$(dirname "$0")"
ROOT=$PWD
COMPOSE=(docker compose -f devenv/docker-compose.yml)
CHROME=zenika/alpine-chrome:124-with-puppeteer
OUT=devenv/out
mkdir -p "$OUT"

chrome() {
  docker run --rm --network host --user "$(id -u):$(id -g)" \
    -e NODE_PATH=/usr/src/app/node_modules -e SHOT_VERBOSE \
    -v "$ROOT:/repo" -w /repo "$CHROME" node /repo/devenv/shot.js "$@"
}

case "${1:-}" in
  up)      "${COMPOSE[@]}" up -d && echo "dev HA: http://192.168.1.241:8125 (dev / devpass1234)" ;;
  down)    "${COMPOSE[@]}" down ;;
  restart) "${COMPOSE[@]}" restart ;;
  logs)    docker logs alfie-dev-ha 2>&1 | tail -n "${2:-60}" ;;
  errors)  docker logs alfie-dev-ha 2>&1 | grep -iE "error|exception|traceback|alfie" | tail -n "${2:-40}" ;;
  wait)    # until HA answers HTTP again (after up/restart)
           for _ in $(seq 90); do curl -sf -o /dev/null http://localhost:8125/manifest.json && exit 0; sleep 2; done
           echo "dev HA did not come up" >&2; exit 1 ;;
  onboard|add|seed|state|call|get|token)
           python3 devenv/devtool.py "$@" ;;
  prod)    # ./dev prod deploy | get ENTITY | ws TYPE [json]: production HA (devenv/prodtool.py)
           shift; python3 devenv/prodtool.py "$@" ;;
  test)    # Python unit tests, then the card maths check under node.
           docker run --rm -v "$ROOT:/src:ro" -v alfie-pip-cache:/root/.cache/pip -w /src \
             -e PYTHONDONTWRITEBYTECODE=1 python:3.13-alpine \
             sh -c "pip install -q --root-user-action=ignore pytest pyyaml >/dev/null && python -m pytest -q -p no:cacheprovider tests"
           # Every node test, in one container: tests/*.test.mjs and tests/screens/*.test.mjs.
           docker run --rm --entrypoint sh -v "$ROOT:/repo:ro" -w /repo "$CHROME" -c '
             fail=0
             for f in tests/*.test.mjs tests/screens/*.test.mjs; do
               [ -f "$f" ] || continue
               node --experimental-detect-module "$f" || { echo "FAILED $f"; fail=1; }
             done
             exit $fail' ;;
  shot)    # ./dev shot [dashboard-path] [out.png] [extra shot.js args...]
           path=${2:-lovelace/0}; out=${3:-$OUT/shot.png}; shift $(( $# < 3 ? $# : 3 ))
           python3 devenv/devtool.py token > "$OUT/.auth.json"
           chrome "http://localhost:8125/$path" "$out" --auth "$OUT/.auth.json" --wait 3000 "$@"
           rm -f "$OUT/.auth.json"; echo "$out" ;;
  dashboard) # (re)create the alfie-dev dashboard in dev HA
           python3 devenv/devtool.py token > "$OUT/.auth.json"
           SHOT_VERBOSE=1 chrome "http://localhost:8125/lovelace/0" "$OUT/.dash.png" --auth "$OUT/.auth.json" \
             --wait 8000 --eval "$(cat devenv/dashboard.js)" 2>&1 | grep -i "alfie" || true
           rm -f "$OUT/.auth.json" "$OUT/.dash.png" ;;
  js)      # ./dev js FILE.js: run a script in a logged-in dev HA page, print its console
           python3 devenv/devtool.py token > "$OUT/.auth.json"
           SHOT_VERBOSE=1 chrome "http://localhost:8125/lovelace/0" "$OUT/.js.png" --auth "$OUT/.auth.json" \
             --wait "${3:-6000}" --eval "$(cat "$2")" 2>&1 | sed -n 's/^\[page log\] //p' || true
           rm -f "$OUT/.auth.json" "$OUT/.js.png" ;;
  house)   # ./dev house: load Lukas's house (devenv/house.json) as dev HA's Alfie config
           { printf 'const CFG = '; cat devenv/house.json; cat <<'JS'
;
(async () => {
  const sleep = (ms) => new Promise((r) => setTimeout(r, ms));
  let h;
  for (let k = 0; k < 80 && !(h = document.querySelector("home-assistant")?.hass)?.connection; k++) await sleep(150);
  try {
    const r = await h.callWS({ type: "alfie/config/set", config: CFG });
    console.log(`house loaded: ${r.config.signals.length} signals, ${r.config.screens.length} screens`);
  } catch (e) { console.log(`house failed: ${e?.message || JSON.stringify(e)}`); }
})();
JS
           } > "$OUT/.house.js"
           "$0" js "$OUT/.house.js" 4000; rm -f "$OUT/.house.js" ;;
  face)    # ./dev face [query] [out.png]: the card alone in devenv/harness.html, no HA
           q=${2:-sheet=moods}; out=${3:-$OUT/face.png}
           chrome "file:///repo/devenv/harness.html?$q" "$out" --size "${SIZE:-1200x900}" --wait 800 --selector '#g'
           echo "$out" ;;
  scope)   # ./dev scope [card-json] [seconds]: alfie-scope (scope/) against dev HA, dry run;
           # plots its newest frame to $OUT/scope.png
           docker build -q -t alfie-scope:dev scope >/dev/null
           tok=$(python3 devenv/devtool.py token | python3 -c 'import json,sys; print(json.load(sys.stdin)["access_token"])')
           docker rm -f alfie-scope-dev >/dev/null 2>&1 || true
           docker run -d --name alfie-scope-dev --network host --user "$(id -u):$(id -g)" -v "$ROOT/$OUT:/out" \
             -e STATS=4 -e DUMP=/out/scope.json -e "ALFIE_CARD=${2:-{\}}" -e XYBENCH_URL= \
             -e HA_URL=http://192.168.1.241:8125 -e HA_TOKEN="$tok" alfie-scope:dev >/dev/null
           sleep "${3:-13}"; docker logs alfie-scope-dev 2>&1 | tail -n 4; docker rm -f alfie-scope-dev >/dev/null
           "$0" face "vecjson=/repo/$OUT/scope.json" "$OUT/scope.png" ;;
  sheet)   # ./dev sheet DIR out.png [cols]: contact sheet of every PNG in DIR (under the repo)
           dir=$2; out=$3; imgs=$(cd "$dir" && ls *.png | paste -sd,)
           chrome "file:///repo/devenv/sheet.html?dir=/repo/$dir&imgs=$imgs&cols=${4:-4}" "$out" --size 1200x900 --wait 500 --selector '#g'
           echo "$out" ;;
  *)       sed -n '2,3p' "$0"
           echo "usage: ./dev up|down|restart|wait|logs [n]|errors [n]"
           echo "       ./dev onboard|add|seed|house|token"
           echo "       ./dev state ENTITY STATE [attrs-json] | call DOMAIN.SERVICE [json] | get ENTITY"
           echo "       ./dev test | dashboard | scope [card-json] [seconds]"
           echo "       ./dev prod deploy | get ENTITY | ws TYPE [json]"
           echo "       ./dev shot [dashboard-path] [out.png] | face [query] [out.png] | sheet DIR out.png [cols]"
           exit 1 ;;
esac
