{
  "_": "Alfie's brain in English (brain.py, answers.py): the sentences of his own commands in Home Assistant's sentence syntax ([optional], (this|that), {list}, <rule>), the lists and rules they use, and his replies. {name} and {area} are wildcards. Keys starting with _ are notes.",
  "commands": {
    "whats_wrong": [
      "(is|are) [there] (anything|something|things) wrong [in the house|at home]",
      "(what is|what's|whats) wrong [in the house|at home]",
      "how is the house [doing]",
      "(any|anything) to worry about"
    ],
    "how_are_you": [
      "how are you [doing|feeling] [today]",
      "how (do|are) you feel[ing] [today]",
      "(are you|you) (ok|okay|alright|all right|happy|sad)",
      "how's it going",
      "(what's|whats|what is) (up|your mood)"
    ],
    "entity": [
      "<what_is> {name}",
      "<what_is> {name} (at|on|reading|showing|set to|doing)",
      "<what_is> the (status|state|reading|value|level) of {name}",
      "<what_is> [the] {attr} (of|on|for) {name}",
      "how (much|many) {name} (is there|are there|do we have|is left|are left)",
      "(is|are) {name} [still] {state} [right now|now]",
      "(is|are) {name} {compare} {value}",
      "(check|read) {name}"
    ],
    "entity_count": [
      "how many {thing} (are|is) [still] {state} [<in_area>]",
      "(which|what) {thing} (are|is) [still] {state} [<in_area>]",
      "(are|is) [there] any {thing} [still] {state} [<in_area>]",
      "(are|is) (anything|something) [still] {state} [<in_area>]",
      "(what's|what is|whats) [still] {state} [<in_area>]",
      "(list|name) [all] [the] {thing} [that are] {state} [<in_area>]",
      "(are|is) all [of] [the] {thing} {state} [<in_area>]"
    ],
    "entity_when": [
      "when (did|was|were|has|have) {name} last {event}",
      "when (did|was|were) {name} {event} [last]",
      "when (did|was|were) {name} last (changed|updated)",
      "when did {name} [last] change",
      "how long (has|have) {name} been [still] {state}",
      "how long ago (did|was|were) {name} {event}",
      "since when (has|have|is|are) {name} been {state}"
    ],
    "entity_history": [
      "(what was|what's|whats|what is) the {stat} {name} [{period}]",
      "(what was|what's|whats|what is) the {stat} (of|for) {name} [{period}]",
      "how (high|warm|hot|much) (did|has) {name} (get|got|been|gone) [{period}]",
      "how many times (did|has|have|was|were) {name} [been] {event} [{period}]",
      "(has|have|did|was|were) {name} (been|turned|gone|go) {event} [{period}]",
      "(did|was|were) {name} {event} {period}"
    ]
  },
  "rules": {
    "what_is": "(what is|what's|whats|what are|what're|tell me|give me|read me)",
    "in_area": "[(in|on|at|around|inside)] [the] {area}"
  },
