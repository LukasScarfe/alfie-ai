{"type": "plot", "title": "Plot", "needs": "history",
 "options": [
   {"key": "entities", "kind": "entities", "label": "Series", "required": true, "domain": ["sensor", "input_number", "number", "counter"], "hint": "1 to 6 sensors."},
   {"key": "title", "kind": "text", "label": "Title", "default": ""},
   {"key": "markers", "kind": "icon", "per": "entities", "label": "Marker", "default": "ring, diamond, square", "presets": ["ring", "diamond", "square", "triangle", "star", "cross", "x", "dot", "house", "sun", "none"], "hint": "Ends each line. A shape, none, or any icon such as mdi:account."},
   {"key": "styles", "kind": "choice", "per": "entities", "label": "Line", "default": "solid", "choices": ["solid", "dotted"]},
   {"key": "labels", "kind": "text", "per": "entities", "label": "Label", "default": "", "hint": "Empty: the friendly name."},
   {"key": "hours", "kind": "number", "label": "Span", "default": 72, "min": 1, "max": 2160, "unit": "h"},
   {"key": "combine", "kind": "choice", "label": "Combine points", "default": "mean", "choices": ["mean", "max", "min", "last"], "hint": "What one point holds: the average, the highest or lowest value, or the value at its end. Max or last keeps counts whole.", "more": true},
   {"key": "shape", "kind": "choice", "label": "Line shape", "default": "straight", "choices": ["straight", "steps"], "hint": "Steps hold each value flat until the next, for counts and on/off levels.", "more": true},
