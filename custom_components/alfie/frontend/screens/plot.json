{"type": "plot", "title": "Plot", "needs": "history",
 "options": [
   {"key": "entities", "kind": "entities", "label": "Series", "required": true, "domain": ["sensor", "input_number", "number", "counter"], "hint": "1 to 6 sensors."},
   {"key": "title", "kind": "text", "label": "Title", "default": ""},
   {"key": "markers", "kind": "icon", "per": "entities", "label": "Marker", "default": "ring, diamond, square", "presets": ["ring", "diamond", "square", "triangle", "star", "cross", "x", "dot", "house", "sun", "none"], "hint": "Ends each line. A shape, none, or any icon such as mdi:account."},
   {"key": "marker_sizes", "kind": "choice", "per": "entities", "label": "Marker size", "default": "normal", "choices": ["small", "normal", "large", "huge"]},
   {"key": "styles", "kind": "choice", "per": "entities", "label": "Line", "default": "solid", "choices": ["solid", "dotted"]},
   {"key": "weights", "kind": "choice", "per": "entities", "label": "Weight", "default": "normal", "choices": ["thin", "normal", "thick", "bold"]},
   {"key": "labels", "kind": "text", "per": "entities", "label": "Label", "default": "", "hint": "Empty: the friendly name."},
   {"key": "hours", "kind": "number", "label": "Span", "default": 72, "min": 1, "max": 2160, "unit": "h"},
   {"key": "combine", "kind": "choice", "label": "Combine points", "default": "mean", "choices": ["mean", "max", "min", "last"], "hint": "What one point holds: the average, the highest or lowest value, or the value at its end. Max or last keeps counts whole.", "more": true},
   {"key": "shape", "kind": "choice", "label": "Line shape", "default": "straight", "choices": ["straight", "steps"], "hint": "Steps hold each value flat until the next, for counts and on/off levels.", "more": true},
   {"key": "range", "kind": "choice", "label": "Value range", "default": "auto", "choices": ["auto", "fixed", "reach"]},
   {"key": "y_min", "kind": "number", "label": "Range minimum", "default": 0, "min": -100000, "max": 100000, "when": {"range": ["fixed", "reach"]}},
   {"key": "y_max", "kind": "number", "label": "Range maximum", "default": 100, "min": -100000, "max": 100000, "when": {"range": ["fixed", "reach"]}},
   {"key": "min_span", "kind": "number", "label": "Smallest auto range", "default": 4, "min": 0.01, "max": 100000, "when": {"range": ["auto", "reach"]}, "more": true},
   {"key": "unit", "kind": "text", "label": "Unit", "default": "", "hint": "Empty: the sensor's. none: no unit."},
   {"key": "decimals", "kind": "number", "label": "Decimals", "default": 0, "min": 0, "max": 3, "hint": "For the latest values."},
   {"key": "axis", "kind": "bool", "label": "Value axis", "default": true},
   {"key": "axis_side", "kind": "choice", "label": "Value axis side", "default": "left", "choices": ["left", "right", "both"], "when": {"axis": [true]}},
   {"key": "value_ticks", "kind": "choice", "label": "Value ticks", "default": "auto", "choices": ["auto", "count", "step", "list"], "hint": "Auto fits the height; or about this many, every this much, or exactly these values.", "when": {"axis": [true]}},
   {"key": "tick_count", "kind": "number", "label": "About this many ticks", "default": 4, "min": 2, "max": 12, "when": {"value_ticks": ["count"]}},
   {"key": "tick_step", "kind": "number", "label": "A tick every", "default": 5, "min": 0.001, "max": 100000, "when": {"value_ticks": ["step"]}},
   {"key": "tick_list", "kind": "text", "label": "Tick values", "default": "", "hint": "Comma separated, such as 0, 25, 50, 100.", "when": {"value_ticks": ["list"]}},
   {"key": "tick_unit", "kind": "choice", "label": "Unit on the value axis", "default": "top", "choices": ["top", "every", "none"], "when": {"axis": [true]}},
   {"key": "tick_decimals", "kind": "choice", "label": "Value axis decimals", "default": "auto", "choices": ["auto", "0", "1", "2", "3"], "when": {"axis": [true]}, "more": true},
   {"key": "tick_marks", "kind": "choice", "label": "Value tick marks", "default": "out", "choices": ["out", "in", "cross", "none"], "when": {"axis": [true]}, "more": true},
   {"key": "axis_line", "kind": "bool", "label": "Value axis line", "default": true, "when": {"axis": [true]}, "more": true},
   {"key": "time_axis", "kind": "bool", "label": "Time axis", "default": true},
   {"key": "time_step", "kind": "choice", "label": "A time label every", "default": "auto", "choices": ["auto", "1h", "2h", "3h", "6h", "12h", "1d", "2d", "7d", "14d", "30d"], "when": {"time_axis": [true]}},
   {"key": "time_format", "kind": "choice", "label": "Time labels", "default": "auto", "choices": ["auto", "hour", "time", "weekday", "day", "date", "relative", "none"], "hint": "hour 14, time 14:00, weekday Thu, day 22, date 22 Oct, relative -6h.", "when": {"time_axis": [true]}},
   {"key": "time_marks", "kind": "choice", "label": "Time tick marks", "default": "out", "choices": ["out", "in", "cross", "none"], "when": {"time_axis": [true]}, "more": true},
   {"key": "grid", "kind": "choice", "label": "Gridlines", "default": "none", "choices": ["none", "values", "times", "both"]},
   {"key": "grid_style", "kind": "choice", "label": "Gridline style", "default": "dotted", "choices": ["dotted", "solid"], "when": {"grid": ["values", "times", "both"]}, "more": true},
   {"key": "now", "kind": "bool", "label": "Latest values at the right", "default": true},
   {"key": "legend", "kind": "bool", "label": "Series labels", "default": false, "hint": "Beside the latest values, or wherever Layout puts them."},
   {"key": "text_size", "kind": "number", "label": "Text size", "default": 1, "min": 0.5, "max": 2, "unit": "×", "hint": "Scales the screen's text. Text fitted to its room still shrinks to fit."},
   {"key": "layout", "kind": "layout", "label": "Layout", "default": {}, "elements": [
     {"key": "title", "label": "Title", "text": true},
     {"key": "plot", "label": "Lines"},
     {"key": "value_axis", "label": "Value axis", "text": true},
     {"key": "time_axis", "label": "Time axis", "text": true},
     {"key": "readouts", "label": "Latest values", "text": true},
     {"key": "legend", "label": "Series labels", "text": true}
   ]}
 ]}
