# Home Assistant, by IP. The token is a long-lived token of a non-admin user
# made for the scope (alfie/subscribe is open to non-admins).
HA_URL=http://192.168.1.217:8123
HA_TOKEN=

# xy-bench's push API, on its compose network. Empty: a dry run that only
# counts frames. XYBENCH_TOKEN is xy-bench's own XYBENCH_TOKEN.
XYBENCH_URL=http://xy-bench:8080
XYBENCH_TOKEN=

# Match xy-bench's aspect setting (the tube's width / height).
ASPECT=1
# Frames a second from the card; xy-bench draws the newest it has. Keep it a
# divisor of 60 (Chromium's frame clock): 30 costs about half what 60 does.
FPS=30
# true: xy-bench traces strokes in the card's order (head, eyes, screen), so
# moving eyes don't shimmy as its tour re-solves. false: its shortest tour.
ORDERED=true
# Any other card options, as JSON: rotation, display, present, transition...
# e.g. {"display": "rotation", "rotation": "scope"}
ALFIE_CARD={}
