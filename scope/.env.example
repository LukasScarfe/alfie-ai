# Home Assistant, by IP. The token is a long-lived token of a non-admin user
# made for the scope (alfie/subscribe is open to non-admins).
HA_URL=http://192.168.1.217:8123
HA_TOKEN=

# xy-bench's push API, on its compose network. Empty: a dry run that only
# counts frames. XYBENCH_TOKEN is xy-bench's own XYBENCH_TOKEN.
XYBENCH_URL=http://xy-bench:8080
XYBENCH_TOKEN=

# Frames a second from the card, paced by a timer. Match the fps xy-bench's
# /api/status shows on the alfie screen; a mismatch judders (60 into 50 skips
# every sixth frame). xy-bench stretches long frames down to XYBENCH_MIN_FPS
# (default 50), so set that to 60 in xy-bench's .env to hold it at 60.
FPS=60
# true: xy-bench traces strokes in the card's order, which is already a short
# tour (the card's vector_order), kept steady so moving parts don't shimmy.
# false: xy-bench re-solves its own tour every frame (~125 ms each, too slow).
ORDERED=true
# The card's options are set on the settings page, http://<this box>:8642/.
# ALFIE_CARD is only the start, before anything is saved there: any card
# options as JSON, e.g. {"display": "rotation", "rotation": "default"}
# (a rotation's id, not its name).
ALFIE_CARD={}
# The settings page: its port (0 turns it off; keep compose.yaml's "ports" equal)
# and a password (any user name). Empty: anyone on the network can change the card.
SETTINGS_PORT=8642
SETTINGS_PASSWORD=
